# Supabase (public values — safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google AI Studio key (server-only, never exposed to the browser)
GEMINI_API_KEY=
# Chat model (no tools) and search model (Google Search grounding).
# Grounding has free-tier quota on the 2.5 family only.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_SEARCH_MODEL=gemini-2.5-flash
